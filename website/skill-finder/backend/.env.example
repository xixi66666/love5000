# 默认读取 website/src/main/resources/application.yml 的 spring.datasource 配置，
# 并解析 WEBSITE_DB_URL / WEBSITE_DB_USERNAME / WEBSITE_DB_PASSWORD 环境变量。
# 仅在需要独立数据库时显式覆盖（凭据必须 URL 编码）：
# DATABASE_URL=mysql+asyncmy://YOUR_USERNAME_HERE:YOUR_PASSWORD_HERE@49.232.128.132:3306/xixi?charset=utf8mb4
# GITHUB_TOKEN 优先从 backend/.secrets/github_token 文件读取（见 README），
# 也支持通过环境变量 GITHUB_TOKEN 提供。
# GITHUB_TOKEN=github_token_here
ADMIN_KEY=replace_with_a_long_random_value
BUSINESS_TIMEZONE=Asia/Shanghai
COLLECTION_CRON=0 2 * * *
SCHEDULER_ENABLED=false
# GitHub Trending 采集：每期取前 N 个 AI 相关项目
TRENDING_TOP_N=10
# 命中以下任一关键词（逗号分隔，不区分大小写）才纳入榜单
TRENDING_AI_KEYWORDS=ai,agent,agents,llm,gpt,claude,anthropic,openai,gemini,deepseek,copilot,mcp,model context protocol,skill,skills,plugin,plugins,rag,prompt,generative,genai,machine learning,neural,embedding,transformer,chatbot,multimodal,computer vision,speech
# GitHub 榜单、API 和 README 共用代理；需要时填写，例如 http://127.0.0.1:7890
TRENDING_PROXY=
CORS_ORIGINS=http://localhost:5173
# 项目简介生成（调用兼容 DeepSeek / OpenCode 的模型 HTTP 接口）
# INTRO_ENABLED=true 时，采集任务会为缺少简介的仓库自动生成
INTRO_ENABLED=false
INTRO_MODEL=opencode-go/deepseek-v4-flash
INTRO_BATCH_SIZE=5
INTRO_TIMEOUT_SECONDS=300
# 兼容 OpenAI Chat Completions 的独立模型服务，例如 DeepSeek：
# INTRO_API_BASE=https://api.deepseek.com
# INTRO_MODEL=deepseek-flash
# INTRO_API_KEY=provide_in_private_env_only
# 也可引用已有本机私有密钥文件（优先于 INTRO_API_KEY），支持纯文本或 JSON 的
# INTRO_API_KEY / DEEPSEEK_API_KEY / intro_api_key / deepseek_api_key / api_key 字段。
# INTRO_API_KEY_FILE=/absolute/path/to/private-key-file

# 日报、配音、竖屏视频与审核
DAILY_REPORTS_DIR=data/daily-reports
DAILY_PUBLIC_URL=http://127.0.0.1:5177
DAILY_TTS_VOICE=zh-CN-YunxiNeural
# 默认使用 Remotion + MiMo；不自动回退静音或其他供应商
DAILY_VIDEO_RENDERER=remotion
DAILY_TTS_PROVIDER=mimo
DAILY_NODE_COMMAND=node
REMOTION_CONCURRENCY=2
DAILY_RENDER_TIMEOUT_SECONDS=1800
MIMO_API_BASE=https://api.xiaomimimo.com/v1
# website 统一文本模型入口复用下面的 MIMO_API_KEY；不影响配音模型。
MIMO_CHAT_MODELS=mimo-v2.6-pro,mimo-v2.6-flash
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=苏打
# MIMO_API_KEY=provide_in_private_env_only
# MIMO_TTS_STYLE=自然中文科技工具推荐，语速明快，突出用途与效果。
DAILY_WHISPER_MODEL=small
DAILY_ASSETS_DIR=data/video-assets
DAILY_REQUIRE_DEMO_ASSETS=true
# ffmpeg / ffprobe 不在 PATH 时可配置完整路径
DAILY_FFMPEG_COMMAND=ffmpeg
DAILY_FFPROBE_COMMAND=ffprobe
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome
# 显式兼容旧卡片生成器：DAILY_VIDEO_RENDERER=legacy（使用原 Edge TTS）
# DAILY_FONT=/path/to/NotoSansCJK-Regular.ttc
# QQ 暂不配置；设置可用的 OpenClaw 命令及目标后再启用送达
DAILY_QQ_TARGET=
DAILY_OPENCLAW_COMMAND=
DOUYIN_PUBLISH_ENABLED=false
DOUYIN_STORAGE_STATE=.secrets/douyin-state.json

# 近 30 天多源研究（调用用户级 ~/.codex/skills/last30days）
LAST30DAYS_ENABLED=true
# 默认会自动发现 skill 与 Python 3.12+；仅在自动发现失败时填写
# LAST30DAYS_SKILL_DIR=C:\Users\YOUR_NAME\.codex\skills\last30days
# LAST30DAYS_PYTHON=C:\path\to\python.exe
# LAST30DAYS_MEMORY_DIR=C:\path\to\last30days-memory
LAST30DAYS_TIMEOUT_SECONDS=600
